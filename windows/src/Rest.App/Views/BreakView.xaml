<UserControl x:Class="Rest.App.Views.BreakView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Rest.App.Views"
             FontFamily="{StaticResource UiFont}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid ClipToBounds="True">

        <!-- 必应壁纸：铺满窗口（scaledToFill 的效果） -->
        <Image Source="{Binding Wallpaper}"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding HasWallpaper, Converter={StaticResource BoolToVis}}" />

        <!-- 没有壁纸时的渐变底 -->
        <Grid Visibility="{Binding HasWallpaper, Converter={StaticResource InverseBoolToVis}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D1729" Offset="0" />
                    <GradientStop Color="#1F3347" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- 压暗：整体 38% -->
        <Rectangle Fill="#61000000" />

        <!-- 中间压暗一点，保证文案在明亮的壁纸上也看得清 -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
                    <GradientStop Color="#57000000" Offset="0" />
                    <GradientStop Color="#1F000000" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 暗角 -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#00000000" Offset="0.35" />
                    <GradientStop Color="#80000000" Offset="0.8" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="48,40,48,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 主内容 -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="{Binding KindTitle}"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#D9FFFFFF"
                           Margin="0,0,0,34">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="10" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- 倒计时中 -->
                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">

                    <Grid Width="262" Height="262" HorizontalAlignment="Center">
                        <views:ProgressRing Progress="{Binding Progress}" Thickness="5" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RemainingText}"
                                       FontFamily="{StaticResource ClockFont}"
                                       FontSize="78"
                                       FontWeight="Thin"
                                       Foreground="White"
                                       HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="14" ShadowDepth="0" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="剩余"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#8CFFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,-6,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding KindCaption}"
                               FontSize="15"
                               Foreground="#D1FFFFFF"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="460"
                               Margin="0,26,0,0" />

                    <!-- 音频卡片 -->
                    <Border MaxWidth="500"
                            Margin="0,26,0,0"
                            CornerRadius="14"
                            Background="#6B000000"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="1"
                            Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="18" ShadowDepth="8" />
                        </Border.Effect>

                        <StackPanel>
                            <Grid Height="32" Margin="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE767;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="#B3FFFFFF"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AudioHeading}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="#BFFFFFFF"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="PauseAllButton"
                                        Content="{Binding PauseAllLabel}"
                                        Style="{StaticResource MiniPill}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding CanPauseAll}"
                                        Click="OnPauseAllClick"
                                        Visibility="{Binding HasPausableAudio, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <Rectangle Height="0.5" Fill="#1AFFFFFF" />

                            <ItemsControl ItemsSource="{Binding VisibleAudioRows}" Margin="0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="{Binding DataContext.AudioRowHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Margin="14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 应用图标当主视觉 -->
                                            <Border Grid.Column="0"
                                                    Width="{Binding DataContext.AudioIconSide, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Height="{Binding DataContext.AudioIconSide, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CornerRadius="10"
                                                    BorderBrush="#1AFFFFFF"
                                                    BorderThickness="0.6"
                                                    Opacity="{Binding IconOpacity}"
                                                    VerticalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#2BFFFFFF" Offset="0" />
                                                        <GradientStop Color="#0DFFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Image Source="{Binding Icon}" Margin="6" Stretch="Uniform" />
                                                    <TextBlock Text="{Binding FallbackLetter}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="#D9FFFFFF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           Opacity="{Binding RowOpacity}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Foreground="#99FFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button Style="{StaticResource CircleIconButton}"
                                                        ToolTip="{Binding ActionTooltip}"
                                                        Click="OnToggleAudioClick"
                                                        Visibility="{Binding ShowAction, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding ActionGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Foreground="#EBFFFFFF" />
                                                </Button>
                                                <TextBlock Text="无法自动暂停"
                                                           FontSize="10"
                                                           Foreground="#61FFFFFF"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding CannotControl, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding HasHiddenAudio, Converter={StaticResource BoolToVis}}">
                                <Rectangle Height="0.5" Fill="#14FFFFFF" />
                                <TextBlock Text="{Binding HiddenAudioText}"
                                           FontSize="10"
                                           Foreground="#73FFFFFF"
                                           Margin="14,6"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasAudioNotice, Converter={StaticResource BoolToVis}}">
                                <Rectangle Height="0.5" Fill="#1AFFFFFF" />
                                <TextBlock Text="{Binding AudioNotice}"
                                           FontSize="10.5"
                                           Foreground="#8CFFFFFF"
                                           Margin="14,7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 延后 / 跳过 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                        <Button Content="{Binding PostponeButtonText}"
                                Style="{StaticResource Pill}"
                                Click="OnPostponeClick"
                                Visibility="{Binding CanPostpone, Converter={StaticResource BoolToVis}}" />
                        <Button Content="跳过"
                                Style="{StaticResource Pill}"
                                Click="OnSkipClick"
                                Margin="12,0,0,0"
                                Visibility="{Binding CanSkip, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>

                <!-- 休息结束，等待继续 -->
                <StackPanel x:Name="FinishedBlock"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsFinishedManual, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE930;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="52"
                               Foreground="#E6FFFFFF"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="休息结束"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0" />
                    <TextBlock FontSize="15" Foreground="#ADFFFFFF" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Run Text="准备好了就继续，下一轮" />
                        <Run Text="{Binding WorkLabel}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Content="{Binding ContinueButtonText}"
                                Style="{StaticResource ProminentPill}"
                                Click="OnContinueClick" />
                        <Button Content="再休息 1 分钟"
                                Style="{StaticResource Pill}"
                                Click="OnExtendClick"
                                Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 底部：提示 + 壁纸版权 -->
            <Grid Grid.Row="3">
                <TextBlock Text="{Binding FooterHint}"
                           FontSize="11.5"
                           Foreground="#80FFFFFF"
                           VerticalAlignment="Bottom">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="6" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding WallpaperCredit}"
                           FontSize="10"
                           Foreground="#52FFFFFF"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           MaxWidth="520"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasCredit, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
