<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标和 Screen.AllScreens 直接用 WinForms，省掉两个第三方包 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- 关掉隐式 using：同时启用 WPF 和 WinForms 时，System.Windows.Forms / System.Drawing
         会和 System.Windows 大面积撞名（Application、UserControl、Brush、Point…） -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Rest</AssemblyName>
    <RootNamespace>Rest.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Resources/Rest.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- 外接 4K + 笔记本屏混合缩放时，遮罩要按每屏 DPI 渲染，否则会糊 / 错位 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rest.Core/Rest.Core.csproj" />
    <ProjectReference Include="../Rest.Platform.Windows/Rest.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="../Resources/Rest.ico" />
  </ItemGroup>

</Project>
